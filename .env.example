# =============================================================================
# Technology Watch Platform - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_DB=techwatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production-use-50-chars-minimum
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=15  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_FRONTEND_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Email Configuration (Development - Console Backend)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Production SMTP (Gmail example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@techwatch.com
# EMAIL_HOST_PASSWORD=your_app_specific_password
# DEFAULT_FROM_EMAIL=noreply@techwatch.com

# -----------------------------------------------------------------------------
# AI Services (Optional - for future AI pipeline implementation)
# -----------------------------------------------------------------------------
# OpenAI API Key for LLM services
OPENAI_API_KEY=

# Firecrawl API Key for web scraping
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Redis Configuration (defaults are usually fine)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Optional: Additional Configuration
# -----------------------------------------------------------------------------
# Uncomment and configure as needed

# CORS Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security Headers (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Logging Level
# LOG_LEVEL=INFO

# =============================================================================
# Quick Start Instructions:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate a secure Django secret key:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Update POSTGRES_PASSWORD with a strong password
# 4. Keep EMAIL_BACKEND as console for development
# 5. Leave AI API keys empty until needed
# 6. Run: docker-compose up -d
# =============================================================================
