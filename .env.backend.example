# .env.backend.example
# Copy this file to .env.backend and fill in actual values
# Never commit .env.backend to Git!

# ============================================
# Database Configuration
# ============================================
# PostgreSQL credentials for the veille_tech_db database
# IMPORTANT: Change POSTGRES_PASSWORD to a strong password (min 16 chars, mixed case, numbers, symbols)
# Generate secure password with: openssl rand -base64 24
POSTGRES_USER=veille_tech_user
POSTGRES_PASSWORD=your_secure_password_here_min_16_chars
POSTGRES_DB=veille_tech_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection String for Django (RECOMMENDED)
# Format: postgresql://user:password@host:port/database
# This is the preferred way to configure database connections
# Parsed by dj-database-url with connection pooling and health checks
# Connection pooling (60s): Reuses connections for better performance
# Health checks: Validates connections before reuse to prevent errors
DATABASE_URL=postgresql://veille_tech_user:your_secure_password_here_min_16_chars@db:5432/veille_tech_db

# ============================================
# Database Migration Configuration
# ============================================
# IMPORTANT: Database migrations require specific privileges
#
# pgvector Extension Setup:
#   - The pgvector extension is required for vector similarity search
#   - Extension creation requires SUPERUSER privilege on PostgreSQL
#   - Grant privilege: ALTER USER veille_tech_user WITH SUPERUSER;
#   - Alternative: Have DBA create extension manually before running migrations
#
# Migration Privilege Strategy:
#   - Development: Grant SUPERUSER to veille_tech_user for convenience
#   - Production: Use two-user approach:
#     1. Migration user (superuser) - Used only for migrations
#     2. Application user (restricted) - Used for runtime operations
#
# Connection Settings (configured in Django settings):
#   - CONN_MAX_AGE: 60 seconds (connection pooling for performance)
#   - conn_health_checks: True (validates connections before reuse)
#   - ATOMIC_REQUESTS: True (wraps requests in transactions for safety)
#
# Required Extensions:
#   - pgvector: Vector similarity search (requires SUPERUSER to create)
#
# Migration Commands:
#   - docker-compose exec backend python manage.py migrate
#   - docker-compose exec backend python manage.py showmigrations
#   - docker-compose exec backend python manage.py makemigrations

# ============================================
# Redis Configuration
# ============================================
# Redis serves two purposes using separate databases:
#   DB 0: Celery broker for task queues
#   DB 1: Application cache for API responses and sessions
# Memory: 256MB with LRU eviction policy for cache management
# Security: Port 6379 NOT exposed to host (internal Docker network only)
# Production: MUST enable Redis AUTH and TLS encryption

REDIS_HOST=redis
REDIS_PORT=6379

# Celery Broker (Redis DB 0)
# Used for task queue management by Celery workers and Beat scheduler
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Cache Backend (Redis DB 1)
# Used by Django cache framework for API responses, sessions, etc.
REDIS_CACHE_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1

# ============================================
# Django Settings
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ============================================
# AI/ML API Keys
# ============================================
# Google AI Studio (required for Gemini models)
# Used by Celery worker tasks for content synthesis and embeddings
# Models: gemini-2.5-flash (synthesis), gemini-2.5-pro (verification), text-embedding-004 (embeddings)
# Get your API key from: https://makersuite.google.com/app/apikey
# IMPORTANT: Required for worker to process AI pipeline tasks
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key-here

# Firecrawl API (required for web scraping)
# Used by Celery worker collection tasks to scrape JavaScript-heavy websites
# Get your API key from: https://firecrawl.dev/
# IMPORTANT: Required for worker to execute content collection tasks
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ============================================
# Email Configuration (optional for local dev)
# ============================================
# Email Backend Options:
#   - django.core.mail.backends.console.EmailBackend (default, prints to console)
#   - django.core.mail.backends.smtp.EmailBackend (for actual SMTP sending)
#   - django.core.mail.backends.filebased.EmailBackend (saves to files)
# For production, use SMTP backend with EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@techwatch.local

# Frontend URL for email verification and password reset links
# This should point to your React frontend application
FRONTEND_URL=http://localhost:3000

# ============================================
# Microsoft Entra ID / Azure AD SSO (optional)
# ============================================
# Leave empty to disable SSO
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:8000/accounts/azure/callback

# ============================================
# Celery Worker Configuration
# ============================================
# Broker URL (Redis DB 0) - Used by Celery workers to receive tasks
# Format: redis://host:port/db_number
# Must match CELERY_BROKER_URL above for worker to connect to task queue
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Result Backend URL (Redis DB 0) - Stores task results and state
# Format: redis://host:port/db_number
# Used for task result retrieval and task state monitoring
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Worker Pool Type - Execution model for task processing
# Options:
#   - 'prefork' (default): Multiprocessing pool for CPU-bound tasks (AI pipeline, data processing)
#     Memory: ~200-500MB per worker process
#   - 'gevent': Greenlet-based async pool for I/O-bound tasks (HTTP requests, database queries)
#     Memory: ~100-200MB total (shared memory)
#     Requires: pip install celery[gevent]
#   - 'eventlet': Alternative async pool similar to gevent
#     Requires: pip install celery[eventlet]
# Recommendation: Use 'prefork' for AI pipeline tasks (LLM calls are CPU/memory intensive)
CELERY_WORKER_POOL=prefork

# Worker Concurrency - Number of concurrent worker processes (prefork) or greenlets (gevent/eventlet)
# Default: 4 (set via docker-compose command with ${CELERY_WORKER_CONCURRENCY:-4})
# Recommendations:
#   - Development: 2-4 (lower resource usage)
#   - Production (prefork): Number of CPU cores (for CPU-bound tasks)
#   - Production (gevent/eventlet): 100-500 greenlets (for I/O-bound tasks)
#   - AI Pipeline: 4-8 (balance between throughput and memory usage for LLM calls)
# Memory usage (prefork): Each worker process uses ~200-500MB depending on task complexity
# Memory usage (gevent): Shared memory, ~100-200MB total
CELERY_WORKER_CONCURRENCY=4

# Worker Task Limit - Maximum tasks per worker before restart (memory leak prevention)
# Default: 100 tasks
# Set to 0 to disable automatic worker restart
# Recommendation: 100-1000 for long-running workers with potential memory leaks
# Purpose: Prevents gradual memory growth by periodically restarting worker processes
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# Task Time Limit (seconds) - Maximum execution time for a single task
# Default: 3600 (1 hour)
# Soft limit triggers SoftTimeLimitExceeded exception (graceful cleanup)
# Hard limit terminates task immediately (configured as CELERY_TASK_TIME_LIMIT + 300s)
# AI pipeline tasks (collection, synthesis) typically take 2-10 minutes
CELERY_TASK_TIME_LIMIT=3600

# Celery Beat Scheduler - Enable/disable recurring task scheduling
# Set to False to disable automatic daily scraping tasks
# Worker service doesn't need this, but scheduler service requires it
CELERY_BEAT_SCHEDULE_ENABLED=True

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Security Settings
# ============================================
# Password hashing algorithm (Argon2 recommended for production)
PASSWORD_HASHERS=django.contrib.auth.hashers.Argon2PasswordHasher

# CSRF and Session
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
