# .env.frontend.example
# Copy this file to .env.frontend and fill in actual values
# Never commit .env.frontend to Git!

# ============================================
# API Configuration
# ============================================
# Backend API URL (no trailing slash, no /api suffix)
# For Docker: use service name 'backend'
# For host development: use localhost
# Note: /api is added by the API client, don't include it here
VITE_API_URL=http://localhost:8000

# ============================================
# Feature Flags (optional)
# ============================================
# Enable Microsoft Entra ID SSO
VITE_ENABLE_SSO=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable debug mode for additional logging
VITE_DEBUG_MODE=false

# ============================================
# Development Settings
# ============================================
# Environment indicator
VITE_ENV=development
