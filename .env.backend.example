# Django Configuration
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For development, SQLite is used by default
# For production, use PostgreSQL with the following settings:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email Configuration
# For development, console backend is used (emails printed to console)
# For production, configure SMTP settings:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@techwatch.com

# Authentication Settings
# Password reset link expires after 60 minutes
# Email verification link expires after 3 days (configured in settings.py)

# CORS Configuration (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Redis Configuration (for Celery and JWT blacklist in future)
# REDIS_URL=redis://localhost:6379/0

# Optional: JWT Token Lifetimes (to be used in US-2)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
